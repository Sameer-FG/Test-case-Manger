# Copy this file to .env on the server and fill in real values.
# Never commit the real .env — it's already covered by .dockerignore, add it to .gitignore too.

PORT=3000

# Self-hosted mongo (docker-compose service name "mongo"). Must match
# MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD below.
MONGODB_URI=mongodb://tcm:CHANGE_ME@mongo:27017/testcaseManager?authSource=admin

MONGO_INITDB_ROOT_USERNAME=tcm
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

# Required in any environment reachable over the network — without it every
# /api route is unauthenticated. The client sends this back as the
# Authorization header.
TEAM_KEY=CHANGE_ME
SLACK_WEBHOOK_URL=
